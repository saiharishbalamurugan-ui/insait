# ── Core (required for Phase 0) ──────────────────────────────────────────
DATABASE_URL="postgresql://audix:audix_dev_password@localhost:5432/audix?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="replace-with-a-long-random-string"
NODE_ENV="development"

BACKEND_PORT=4000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── Phase 2: AI Audit Engine ─────────────────────────────────────────────
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""

# ── Phase 3: QuickBooks Online integration ───────────────────────────────
# Create a sandbox app at https://developer.intuit.com
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_REDIRECT_URI="http://localhost:4000/api/quickbooks/callback"
QUICKBOOKS_ENVIRONMENT="sandbox"

# ── Phase 4: Email ingestion + OCR ────────────────────────────────────────
# Microsoft Graph app registration: https://portal.azure.com (Azure AD App Registrations)
MICROSOFT_GRAPH_CLIENT_ID=""
