generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tenancy & auth ──────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  invoices             Invoice[]
  timesheets           Timesheet[]
  months               Month[]
  quickbooksConnection QuickBooksConnection?
  emailIngestionLogs   EmailIngestionLog[]
  chatSessions         ChatSession[]
  invoiceDeletionLogs  InvoiceDeletionLog[]
}

// ── Monthly workspaces ──────────────────────────────────────────────────
// Invoices/roster rows are tagged with a plain "YYYY-MM" label (not an FK) —
// exactly one Month per org is current (editable); everything else is read-only history.
model Month {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  label     String // "2026-07"
  isCurrent Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([organizationId, label])
  @@index([organizationId])
}

enum UserRole {
  ADMIN
  REVIEWER
}

enum UserStatus {
  INVITED // created by an Admin, hasn't set a password yet — can't log in
  ACTIVE
  DEACTIVATED // not hard-deleted, so historical actions stay attributable
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String? // null while status = INVITED
  name           String
  role           UserRole     @default(REVIEWER)
  status         UserStatus   @default(ACTIVE)
  lastLoginAt    DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Only set while status = INVITED. Stores a hash, never the raw token — same reason
  // passwords are hashed, so a DB leak alone can't be used to accept someone else's invite.
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?

  chatSessions        ChatSession[]
  approvalLogs         ApprovalLog[]
  invoiceDeletionLogs  InvoiceDeletionLog[]
}

// ── QuickBooks Online integration (Phase 3) ────────────────────────────

model QuickBooksConnection {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  realmId        String
  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime
  lastSyncedAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ── Invoices ─────────────────────────────────────────────────────────────

enum InvoiceSource {
  MANUAL_UPLOAD
  EMAIL_INGESTION
}

enum InvoiceStatus {
  PENDING
  PROCESSING
  AUDITED
  FAILED
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  vendorName    String
  invoiceNumber String
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD")
  issueDate     DateTime
  dueDate       DateTime?
  source        InvoiceSource @default(MANUAL_UPLOAD)
  status        InvoiceStatus @default(PENDING) // audit pipeline stage — not the human approval decision

  // Human approval decision — separate from `status` above (pipeline stage) and from the AI's
  // own risk label (Approved/Flagged/High Risk), which is a different concept that happens to
  // share the word "Approved". This field is the single source of truth for approve/reject UI.
  approvalStatus ApprovalStatus @default(PENDING_APPROVAL)
  approvalLogs   ApprovalLog[]

  month String // "YYYY-MM" — the month this invoice was uploaded into, set once at creation

  // Staffing/consulting invoice fields — who is being billed for what
  consultantName String?
  project        String?
  managerName    String?
  hours          Decimal? @db.Decimal(6, 2)
  hourlyRate     Decimal? @db.Decimal(12, 2)

  matchedTimesheetId String?    @unique
  matchedTimesheet   Timesheet? @relation(fields: [matchedTimesheetId], references: [id])

  fileUrl                 String?
  extractedData           Json?
  extractedFieldPositions Json? // normalized (0-1) bounding boxes per field, from AI extraction — for on-document annotation

  lineItems    InvoiceLineItem[]
  auditReports AuditReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, month])
  @@index([organizationId, month, approvalStatus])
}

enum ApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

// Audit trail for approve/reject decisions — separate from the single reviewAction/reviewedAt
// fields on AuditReport, which only ever hold the *latest* decision. This keeps history.
model ApprovalLog {
  id        String         @id @default(cuid())
  invoiceId String
  invoice   Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  action      ApprovalAction
  actorUserId String? // nullable: SetNull on user removal, and null for pre-auth rows logged with only a free-text name
  actorUser   User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName   String? // denormalized display name — real user's name once logged in, or a legacy free-text session label
  notes       String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// Deliberately NOT an FK relation to Invoice — a cascade delete would wipe this exact record
// the moment the invoice it documents is removed, defeating the point of a deletion log.
model InvoiceDeletionLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invoiceId     String
  invoiceNumber String
  vendorName    String
  month         String

  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName   String?

  deletedAt DateTime @default(now())

  @@index([organizationId])
}

model InvoiceLineItem {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  consultantName String? // who this specific line item bills — an invoice can bill more than one consultant across its line items
  description    String
  quantity       Decimal? @db.Decimal(12, 2) // null, not 0, when the invoice's quantity isn't genuinely hours (e.g. a flat monthly fee)
  rate           Decimal? @db.Decimal(12, 2) // null, not 0, when there's no true per-hour rate to report
  amount         Decimal  @db.Decimal(12, 2)
}

// ── Approved hours roster (manually uploaded until Ceipal is connected) ──

model Timesheet {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sourceId     String?  @unique // external system id, when synced (e.g. future Ceipal id); null for roster uploads
  employeeName String
  workDate     DateTime // anchor date; equals weekStart when known
  weekStart    DateTime?
  weekEnd      DateTime?
  country      String    @default("US")
  hours        Decimal  @db.Decimal(6, 2)
  hourlyRate   Decimal  @db.Decimal(12, 2) // pay rate — what's paid to the consultant/vendor
  billRate     Decimal? @db.Decimal(12, 2) // what's billed to the end client — not every sheet has this
  vendor       String? // the staffing vendor/agency — kept as its own field so invoice-to-roster
                        // matching can check it, not just folded into `project` as a fallback
  project      String?
  managerName  String?

  month String // "YYYY-MM" — the month this roster row was uploaded for

  matchedInvoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, month])
}

// ── AI audit results (Phase 2) ──────────────────────────────────────────

enum DiscrepancyType {
  OVERBILLING
  DUPLICATE_CHARGE
  RATE_MISMATCH
  HOURS_MISMATCH
  MISSING_TIMESHEET
  UNAUTHORIZED_VENDOR
  DATE_MISMATCH
  TAX_ERROR
  HOLIDAY_OVERBILLING
  DUE_DATE_MISMATCH
  DUPLICATE_INVOICE
  MISSING_REQUIRED_FIELD
  OTHER
}

enum AuditReportStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportReviewAction {
  APPROVED
  REJECTED
  CLARIFICATION_REQUESTED
}

model AuditReport {
  id        String            @id @default(cuid())
  invoiceId String
  invoice   Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  status    AuditReportStatus @default(IN_PROGRESS)

  overallRiskScore Int? // 0-100
  summary          String?
  overpayEstimate  Decimal? @db.Decimal(12, 2) // dollar amount at risk, computed at report time

  reviewAction     ReportReviewAction?
  reviewedAt       DateTime?

  findings AuditFinding[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([invoiceId])
}

model AuditFinding {
  id            String          @id @default(cuid())
  auditReportId String
  auditReport   AuditReport     @relation(fields: [auditReportId], references: [id], onDelete: Cascade)

  discrepancyType DiscrepancyType
  severity        Severity
  explanation     String
  expectedValue   String?
  actualValue     String?
  evidence        Json?

  createdAt DateTime @default(now())

  @@index([auditReportId])
}

// ── Email ingestion (Phase 4) ───────────────────────────────────────────

enum EmailIngestionStatus {
  RECEIVED
  OCR_PROCESSING
  INVOICE_CREATED
  IGNORED
  FAILED
}

model EmailIngestionLog {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  graphMessageId String               @unique
  fromAddress    String
  subject        String
  status         EmailIngestionStatus @default(RECEIVED)
  errorMessage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// ── AI chat widget ───────────────────────────────────────────────────────

model ChatSession {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages ChatMessage[]

  createdAt DateTime @default(now())
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id            String      @id @default(cuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  role          ChatRole
  content       String

  createdAt DateTime @default(now())
}
